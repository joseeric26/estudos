CREATE TABLE Fornecedor (
    id INT PRIMARY KEY,
    nome VARCHAR(100),
    fornecimento VARCHAR(100),
    telefone VARCHAR(15)
);
CREATE TABLE Produtos (
    id INT PRIMARY KEY,
    nome VARCHAR(100),
    numeroSerie VARCHAR(100),
    preço VARCHAR(15)
);
CREATE TABLE Categoria (
    id INT PRIMARY KEY,
    decrição VARCHAR(100),
);
CREATE TABLE Clientes (
    id INT PRIMARY KEY,
    nome VARCHAR(100),
    email VARCHAR(100),
    telefone VARCHAR(15),
); 
1:N Clienta -compra- Produto
1:N Categoria - Produto
1:N → Fornecedor - Produto