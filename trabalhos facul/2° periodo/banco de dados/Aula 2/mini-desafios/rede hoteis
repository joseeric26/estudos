CREATE TABLE Hospede (
    id INT PRIMARY KEY,
    nome VARCHAR(100),
    quarto VARCHAR(100),
    tempo TIME,
    reserva VARCHAR(100),
    telefone VARCHAR(100)
);
CREATE TABLE Serviço (
    id INT PRIMARY KEY,
    nome VARCHAR(100),
    tempo VARCHAR(100),
    preço VARCHAR(1500),
     CONSTRAINT FK_Serviço_Hospede
        FOREIGN KEY (hospede_id) REFERENCES Hospede(id)
);