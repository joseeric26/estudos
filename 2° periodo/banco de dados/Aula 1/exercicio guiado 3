CREATE TABLE Veiculo (
    id INT PRIMARY KEY,
    nome VARCHAR(100),
    modelo VARCHAR(100),
    kilometragem VARCHAR(15)
);
CREATE TABLE Aluguel (
    id INT PRIMARY KEY,
    preço VARCHAR(100),
    tempo VARCHAR(100),
);
CREATE TABLE Cliente (
    id INT PRIMARY KEY,
    nome VARCHAR(100),
    email VARCHAR(100),
    telefone VARCHAR(15)
);
N:N N:N 1:1 →Veiculo - Cliente - Aluguel - Veiculo 