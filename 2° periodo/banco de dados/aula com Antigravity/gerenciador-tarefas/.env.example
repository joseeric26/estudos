# ==============================================================================
# ARQUIVO DE EXEMPLO DE VARIÁVEIS DE AMBIENTE (.env.example)
# Copie este arquivo para .env na raiz do projeto antes de iniciar o Docker:
# Windows (PowerShell): Copy-Item .env.example .env
# ==============================================================================

# Credenciais de Autenticação do Administrador no MongoDB
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=adminpassword123

# Nome do Banco de Dados NoSQL da aplicação
MONGODB_DB=task_manager

# URI de Conexão interna para os microsserviços via Docker Compose
# NOTA: Dentro da rede interna 'task_manager_network', o host do banco é 'mongodb'
MONGODB_URI=mongodb://admin:adminpassword123@mongodb:27017/task_manager?authSource=admin

# Armazenamento e Limites de Upload de Arquivos
# No Docker: /app/uploads mapeado para o volume task_manager_uploads_data
# Fora do Docker (local): ./uploads
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE_BYTES=15728640
