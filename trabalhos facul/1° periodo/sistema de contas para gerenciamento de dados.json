{
  "name": "sistema de contas",
  "nodes": [
    {
      "parameters": {
        "public": true,
        "initialMessages": "Olá! Sou seu assistente de gerenciamento de contas.\n\nPosso ajudá-lo a:\n• Consultar contas existentes\n• Adicionar novas contas\n\nComo posso ajudar?",
        "options": {
          "allowFileUploads": true,
          "inputPlaceholder": "Digite sua mensagem...",
          "loadPreviousSession": "memory",
          "showWelcomeScreen": true,
          "getStarted": "Iniciar Conversa",
          "subtitle": "Consulte e adicione contas facilmente",
          "title": "Gerenciamento de Contas"
        }
      },
      "id": "103e40f5-eb07-4853-a95d-5274c9999452",
